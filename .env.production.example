# Overlay loaded when TARGET_ENV=production (overrides .env).
# Copy to .env.production and adjust if needed. Do not put secrets here.

TARGET_ENV=production
ALLOW_PRODUCTION_WRITES=false

PUBLIC_WEB_URL=https://turnolink.app
PROFESSIONAL_WEB_URL=https://admin.turnolink.app
API_BASE_URL=https://api.turnolink.app

# Optional: dedicated production E2E tenant (future controlled writes only)
# E2E_ALLOWED_COMPANY_SLUG=turnolink-e2e-production
