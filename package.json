{
  "name": "turnolink-testing",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end tests for TurnoLink (Playwright)",
  "scripts": {
    "check-env": "node scripts/check-env.mjs",
    "test": "npm run check-env && playwright test",
    "test:smoke": "npm run check-env && playwright test --grep @smoke",
    "test:auth": "npm run check-env && playwright test --grep @auth",
    "test:journeys": "npm run check-env && playwright test --grep @journey",
    "seed": "node scripts/django-e2e.mjs seed",
    "reset": "node scripts/django-e2e.mjs reset",
    "calendar:status": "node scripts/django-e2e.mjs calendar-status",
    "test:calendar": "npm run check-env && playwright test --grep @calendar",
    "test:local": "TARGET_ENV=local npm run test",
    "test:production": "TARGET_ENV=production npm run check-env && TARGET_ENV=production playwright test tests/production",
    "test:headed": "npm run check-env && playwright test --headed",
    "test:ui": "npm run check-env && playwright test --ui",
    "test:debug": "npm run check-env && playwright test --debug",
    "report": "playwright show-report artifacts/playwright-report",
    "codegen:public": "playwright codegen ${PUBLIC_WEB_URL:-http://localhost:3000}",
    "codegen:professional": "playwright codegen ${PROFESSIONAL_WEB_URL:-http://localhost:3001}",
    "cli": "playwright cli",
    "cli:public": "playwright cli -s=public open ${PUBLIC_WEB_URL:-http://localhost:3000} --headed",
    "cli:professional": "playwright cli -s=professional open ${PROFESSIONAL_WEB_URL:-http://localhost:3001} --headed",
    "mcp:hermes": "npx --yes @playwright/mcp@latest --port 8931 --host 0.0.0.0 --isolated --allowed-hosts 192.168.1.9:8931,192.168.1.9,127.0.0.1,localhost"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^20.19.0",
    "dotenv": "^16.6.1",
    "typescript": "^5.9.2"
  }
}
