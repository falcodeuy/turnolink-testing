# Ambiente objetivo: local | staging | production
TARGET_ENV=local

# Frontends
PUBLIC_WEB_URL=http://localhost:3000
PROFESSIONAL_WEB_URL=http://localhost:3001

# Backend API (asserts/setup y login vía API)
API_BASE_URL=http://localhost:8000

# Ruta al repo Django (hermano). Seeds usan BACKEND_ROOT/venv
BACKEND_ROOT=../turnolink-backend

# Producción: escrituras (default false)
ALLOW_PRODUCTION_WRITES=false

# Dedicated E2E company slug (must match `manage.py e2e_seed --slug`)
E2E_ALLOWED_COMPANY_SLUG=turnolink-e2e

# Professional credentials — defaults match `manage.py e2e_seed`
E2E_PROFESSIONAL_EMAIL=e2e-owner@turnolink.local
E2E_PROFESSIONAL_PASSWORD=e2e-owner-pass-123

# Record browser video for every test (on | retain-on-failure | off)
E2E_VIDEO=on

# Hermes Playwright MCP (npm run mcp:hermes) — LAN IP of the host running MCP
HERMES_MCP_PORT=8931
HERMES_MCP_HOST=0.0.0.0
HERMES_ALLOWED_HOSTS=127.0.0.1,localhost
# Example LAN: HERMES_ALLOWED_HOSTS=192.168.1.9:8931,192.168.1.9,127.0.0.1,localhost

# Futuro
# E2E_CLIENT_EMAIL=
# E2E_CLIENT_PASSWORD=
# E2E_API_TOKEN=
