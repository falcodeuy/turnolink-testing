# Ambiente objetivo: local | staging | production
TARGET_ENV=local

# Frontends
PUBLIC_WEB_URL=http://localhost:3000
PROFESSIONAL_WEB_URL=http://localhost:3001

# Backend API (asserts/setup futuros; no obligatorio para smoke M1)
API_BASE_URL=http://localhost:8000

# Ruta al repo Django (hermano). Seeds futuros usan BACKEND_ROOT/venv
BACKEND_ROOT=../turnolink-backend

# Producción: escrituras (default false; M1 no usa writes)
ALLOW_PRODUCTION_WRITES=false

# Tenant E2E permitido (futuro; vacío en local)
E2E_ALLOWED_COMPANY_SLUG=

# Credenciales / seeds (futuro; no usados en M1)
# E2E_PROFESSIONAL_EMAIL=
# E2E_PROFESSIONAL_PASSWORD=
# E2E_CLIENT_EMAIL=
# E2E_CLIENT_PASSWORD=
# E2E_API_TOKEN=
