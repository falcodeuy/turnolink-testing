# Ambiente objetivo: local | staging | production
TARGET_ENV=local

# Frontends
PUBLIC_WEB_URL=http://localhost:3000
PROFESSIONAL_WEB_URL=http://localhost:3001

# Backend API (asserts/setup y login vía API)
API_BASE_URL=http://localhost:8000

# Ruta al repo Django (hermano). Seeds usan BACKEND_ROOT/venv
BACKEND_ROOT=../turnolink-backend

# Producción: escrituras (default false)
ALLOW_PRODUCTION_WRITES=false

# Dedicated E2E company slug (must match `manage.py e2e_seed --slug`)
E2E_ALLOWED_COMPANY_SLUG=turnolink-e2e

# Professional credentials — defaults match `manage.py e2e_seed`
E2E_PROFESSIONAL_EMAIL=e2e-owner@turnolink.local
E2E_PROFESSIONAL_PASSWORD=e2e-owner-pass-123

# Record browser video for every test (on | retain-on-failure | off)
E2E_VIDEO=on

# Google OAuth E2E (dedicated Chrome + remote debugging)
# Chrome blocks CDP on the default profile path — use a dedicated user-data-dir.
# Point SOURCE_PROFILE at the Chrome profile folder that already has that Google session.
E2E_GOOGLE_EMAIL=you@example.com
E2E_CHROME_CDP_URL=http://127.0.0.1:9222
E2E_CHROME_CDP_PORT=9222
E2E_CHROME_USER_DATA_DIR=~/Library/Application Support/TurnoLink/ChromeGoogleAuth
E2E_CHROME_SOURCE_PROFILE=~/Library/Application Support/Google/Chrome/Profile N
# npm run chrome:google-auth
# npm run chrome:google-auth -- --sync
# npm run test:google-auth

# Futuro
# E2E_CLIENT_EMAIL=
# E2E_CLIENT_PASSWORD=
# E2E_API_TOKEN=
